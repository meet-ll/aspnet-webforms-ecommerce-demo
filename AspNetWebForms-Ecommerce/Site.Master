<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="AspNetWebFormsDemo.SiteMaster" %>
<!DOCTYPE html>
<html><head runat="server"><title><%= Page.Title %> | Shop Demo</title>
<link href="<%= ResolveUrl("~/Content/site.css") %>" rel="stylesheet" />
<script src="<%= ResolveUrl("~/Scripts/site.js") %>"></script></head>
<body><form id="masterForm" runat="server">
<header><h1>Shop Admin — Web Forms Demo</h1><nav>
<asp:HyperLink ID="lnkProduct" runat="server" NavigateUrl="~/ProductEntry.aspx" Text="Product" /> |
<asp:HyperLink ID="lnkCustomer" runat="server" NavigateUrl="~/CustomerProfile.aspx" Text="Customer" /> |
<asp:HyperLink ID="lnkAddress" runat="server" NavigateUrl="~/ShippingAddress.aspx" Text="Shipping Address" /> |
<asp:HyperLink ID="lnkOrder" runat="server" NavigateUrl="~/OrderEntry.aspx" Text="Order" /> |
<asp:HyperLink ID="lnkPayment" runat="server" NavigateUrl="~/PaymentDetails.aspx" Text="Payment" />
</nav></header><main><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
<footer><asp:Label ID="lblFooter" runat="server" Text="Demo only — no data is persisted." /></footer>
</form></body></html>
